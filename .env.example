# ==============================================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Projeto: DayZ Nasdara Tactical Map & Squad Base
# Instruções para GitHub e Vercel:
# 1. Copie este arquivo para ".env" no seu ambiente local (o arquivo .env NUNCA será commitado).
# 2. Na Vercel (Project Settings -> Environment Variables), adicione cada variável abaixo.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (PostgreSQL / Cloud SQL / Neon / Supabase / Vercel Postgres)
# ------------------------------------------------------------------------------
# Opção A: URL de conexão única padrão (Recomendado para Vercel, Supabase ou Neon)
# Exemplo: postgresql://postgres:senha123@ep-cool-db.us-east-1.aws.neon.tech:5432/dayz_nasdara?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/database_name?sslmode=require"

# Opção B: Parâmetros individuais (Cloud SQL / PostgreSQL local / VPS)
SQL_HOST="localhost"
SQL_PORT=5432
SQL_USER="postgres"
SQL_PASSWORD="sua_senha_secreta"
SQL_DB_NAME="dayz_nasdara"

# Credenciais administrativas para migrações Drizzle (opcional)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="sua_senha_secreta"

# Controle de SSL do PostgreSQL (true para produção gerenciada na nuvem, false para Docker local)
DATABASE_SSL="true"

# ------------------------------------------------------------------------------
# 2. AUTENTICAÇÃO FIREBASE & GOOGLE (Frontend Vite & Backend Admin)
# ------------------------------------------------------------------------------
# Variáveis públicas do Frontend (iniciadas com VITE_ para exposição segura no Vite)
VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto-firebase.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-firebase"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto-firebase.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Variável de Backend (Node.js / Express / Firebase Admin SDK)
FIREBASE_PROJECT_ID="seu-projeto-firebase"

# ------------------------------------------------------------------------------
# 3. SERVIDOR & DEPLOY (Vercel / Node.js)
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000

# URL pública da sua aplicação (ex: https://meu-mapa-dayz.vercel.app ou https://meudominio.com)
APP_URL="https://meu-mapa-dayz.vercel.app"

# ------------------------------------------------------------------------------
# 4. APIs DE IA & SERVIÇOS ADICIONAIS (Se aplicável)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"

